# Discord bot credentials — Discord Developer Portal > your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed if you deploy slash commands to ONE server for instant testing.
# Leave blank to register commands globally (takes up to ~1 hour to show up everywhere).
DISCORD_GUILD_ID=

# Google AI Studio > Get API key
GEMINI_API_KEY=
# Safe to leave as-is. Override only if you want a different Gemini model.
GEMINI_MODEL=gemini-3.1-flash-lite
